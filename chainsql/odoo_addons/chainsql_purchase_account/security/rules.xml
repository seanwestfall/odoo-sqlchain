<odoo>
<record id="group_advisory_agent" model="res.groups"><field name="name">Purchasing advisory agent (read only evidence)</field><field name="implied_ids" eval="[(4, ref('chainsql_base.group_operator')), (4, ref('account.group_account_readonly'))]"/></record>
<record id="policy_company" model="ir.rule"><field name="name">Purchasing policy company</field><field name="model_id" ref="model_chainsql_purchase_policy"/><field name="domain_force">[('company_id','in',company_ids)]</field></record>
<record id="decision_company" model="ir.rule"><field name="name">Purchasing decision company</field><field name="model_id" ref="model_chainsql_purchase_decision"/><field name="domain_force">[('company_id','in',company_ids)]</field></record>
</odoo>
