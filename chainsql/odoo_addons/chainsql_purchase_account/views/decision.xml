<odoo>
<record id="policy_form" model="ir.ui.view"><field name="name">chainsql.purchase.policy.form</field><field name="model">chainsql.purchase.policy</field><field name="arch" type="xml"><form><sheet><group><field name="name"/><field name="company_id"/><field name="enabled"/><field name="limit_atomic"/><field name="budget_atomic"/><field name="used_atomic"/><field name="approval_hours"/><field name="version"/></group></sheet></form></field></record>
<record id="policy_action" model="ir.actions.act_window"><field name="name">Purchasing Policies</field><field name="res_model">chainsql.purchase.policy</field><field name="view_mode">list,form</field></record>
<menuitem id="purchase_root" name="ChainSQL Decisions" groups="chainsql_base.group_operator"/>
<menuitem id="purchase_policy_menu" name="Purchasing Policies" parent="purchase_root" action="policy_action" groups="chainsql_base.group_approver"/>
<record id="decision_form" model="ir.ui.view"><field name="name">chainsql.purchase.decision.form</field><field name="model">chainsql.purchase.decision</field><field name="arch" type="xml"><form create="0" edit="0" delete="0"><header><button name="action_human_pay" type="object" string="Human: Pay now" groups="chainsql_base.group_approver" invisible="human_by"/><button name="action_human_hold" type="object" string="Human: Hold" groups="chainsql_base.group_approver" invisible="human_by"/><button name="action_execute" type="object" string="Execute eligible decision" invisible="executed or proposed_action != 'pay_now'"/></header><sheet><div class="alert alert-info" role="status">Recommendations cannot change recipients or spending controls. Execution rechecks evidence and requires existing payment authority. Discount amounts require separate review.</div><group><field name="operation_id"/><field name="company_id"/><field name="model_version"/><field name="proposed_action"/><field name="defer_until"/><field name="justification"/><field name="policy_outcome"/><field name="policy_version"/><field name="policy_revision"/><field name="policy_id"/><field name="created_by"/><field name="human_choice"/><field name="human_reason"/><field name="human_by"/><field name="executed"/><field name="execution_reference"/></group><notebook><page string="Evidence"><field name="evidence_hash"/><field name="evidence"/></page><page string="Deterministic baseline"><field name="baseline"/></page></notebook></sheet></form></field></record>
<record id="decision_list" model="ir.ui.view"><field name="name">chainsql.purchase.decision.list</field><field name="model">chainsql.purchase.decision</field><field name="arch" type="xml"><list create="0" edit="0" delete="0"><field name="operation_id"/><field name="proposed_action"/><field name="policy_outcome"/><field name="human_choice"/><field name="executed"/><field name="company_id"/></list></field></record>
<record id="decision_action" model="ir.actions.act_window"><field name="name">Purchasing Decisions</field><field name="res_model">chainsql.purchase.decision</field><field name="view_mode">list,form</field></record>
<menuitem id="purchase_decision_menu" name="Decisions" parent="purchase_root" action="decision_action"/>
<record id="operation_purchase" model="ir.ui.view"><field name="name">chainsql.operation.purchasing</field><field name="model">chainsql.operation</field><field name="inherit_id" ref="chainsql_base.operation_form"/><field name="arch" type="xml"><xpath expr="//header" position="inside"><button name="action_recommend_purchase" type="object" string="Evaluate purchasing evidence"/></xpath><xpath expr="//sheet" position="inside"><group string="Purchasing decisions"><field name="purchase_decision_ids" nolabel="1"><list create="0" edit="0" delete="0"><field name="proposed_action"/><field name="policy_outcome"/><field name="justification"/><field name="human_choice"/><field name="executed"/></list></field></group></xpath></field></record>
</odoo>
