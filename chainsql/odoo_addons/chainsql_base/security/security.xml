<odoo>
    <record id="privilege_chainsql" model="res.groups.privilege">
        <field name="name">ChainSQL</field>
    </record>
    <record id="group_operator" model="res.groups">
        <field name="name">Test operator</field>
        <field name="privilege_id" ref="privilege_chainsql" />
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]" />
    </record>
    <record id="group_approver" model="res.groups">
        <field name="name">Test approver</field>
        <field name="privilege_id" ref="privilege_chainsql" />
        <field name="implied_ids" eval="[(4, ref('group_operator'))]" />
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]" />
    </record>
    <record id="wallet_company_rule" model="ir.rule">
        <field name="name">ChainSQL wallet company isolation</field>
        <field name="model_id" ref="model_chainsql_wallet_approval" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="operation_company_rule" model="ir.rule">
        <field name="name">ChainSQL operation company isolation</field>
        <field name="model_id" ref="model_chainsql_operation" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>