<odoo>
<record id="document_form" model="ir.ui.view"><field name="name">chainsql.document.version.form</field><field name="model">chainsql.document.version</field><field name="arch" type="xml"><form create="0" edit="0" delete="0"><header><button name="action_approve" type="object" string="Approve retained version" groups="chainsql_base.group_approver" invisible="approved_by or purged"/><button name="action_verify_source" type="object" string="Verify source bytes"/><button name="action_purge" type="object" string="Purge after retention" groups="chainsql_base.group_approver"/></header><sheet><div class="alert alert-info" role="status">This proof binds exact bytes; it does not establish that the document is true. Public commitments contain only a salted digest. Original attachments remain subject to Odoo storage and retention controls.</div><group><field name="version_id"/><field name="company_id"/><field name="move_id"/><field name="source_attachment_id"/><field name="source_version"/><field name="source_reference"/><field name="sha256"/><field name="commitment"/><field name="retain_until"/><field name="approved_by"/><field name="approved_at"/><field name="purged"/></group></sheet></form></field></record>
<record id="document_list" model="ir.ui.view"><field name="name">chainsql.document.version.list</field><field name="model">chainsql.document.version</field><field name="arch" type="xml"><list create="0" edit="0" delete="0"><field name="version_id"/><field name="source_attachment_id"/><field name="approved_by"/><field name="retain_until"/><field name="purged"/></list></field></record>
<record id="bill_documents" model="ir.ui.view"><field name="name">account.move.chainsql.documents</field><field name="model">account.move</field><field name="inherit_id" ref="account.view_move_form"/><field name="arch" type="xml"><xpath expr="//header" position="inside"><button name="action_snapshot_bill_attachments" type="object" string="Snapshot private attachments" groups="chainsql_base.group_approver" invisible="move_type != 'in_invoice'"/></xpath><xpath expr="//notebook" position="inside"><page string="Document proofs" groups="chainsql_base.group_operator"><field name="chainsql_document_ids" readonly="1"/></page></xpath></field></record>
</odoo>
